# Ambedkar Digital Heritage Archive — Environment Variables Template
# Copy this file to .env and fill in all values before starting the server.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/ambedkar-archive

# Authentication (REQUIRED: use a strong random string of min 32 chars)
JWT_SECRET=CHANGE_ME_use_crypto_randomBytes_48_toString_hex
JWT_EXPIRES_IN=7d

# Google OAuth (for secure Google Sign-In verification)
# Get from https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini AI (for real AI chatbot)
# Get from https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# Frontend URL (for CORS whitelist)
FRONTEND_URL=http://localhost:3000

# ── Free Email OTP Delivery Option 1: Gmail SMTP (100% Free, NO custom domain needed)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-char password below:
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Email OTP Delivery Option 2: Resend API (Requires verified custom domain for general delivery)
RESEND_API_KEY=
EMAIL_FROM=

# ── WhatsApp OTP Delivery (Meta WhatsApp Cloud API — https://developers.facebook.com)
# Free development sandbox sends to up to 5 verified recipient phone numbers
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_OTP_TEMPLATE_NAME=

# ── WhatsApp OTP Alternative: Twilio Verify (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Telegram OTP Delivery (100% Permanently FREE — https://t.me/BotFather)
# 1. Message @BotFather on Telegram, send /newbot, give it a name & username
# 2. Paste the HTTP API token below.
# 3. Permanent $0 cost, unlimited messages, zero ban risk.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AmbedkarArchiveBot

# ── Safe Development Mode (true = logs real OTP to server console if credentials unset)
DEV_AUTH_MODE=true
